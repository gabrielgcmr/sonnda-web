{
  "name": "sonnda-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "web": "bunx --bun vite",
    "api": "bash -lc 'cd ~/dev/sonnda && make dev'",
    "all": "concurrently -n WEB,API -c auto \"bun run web\" \"bun run api\"",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "openapi:check": "bun run openapi:generate && git diff --exit-code -- src/generated/openapi.d.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "bun test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.51.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "20.14.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
